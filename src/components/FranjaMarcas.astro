---
import Icon from './Icon.astro';
import { marcasConCatalogo, logoMarca, marcas } from '../lib/data';
const lista = marcasConCatalogo.filter((m) => logoMarca(m.slug));
---
<section class="franja" aria-label="Marcas representadas">
  <div class="wrap">
    <div class="rotulo">Representantes directos de las marcas más prestigiosas del mercado <a class="btn-enlace btn" href="/marcas/">Ver las {marcas.length} marcas <Icon name="flecha" size={16} /></a></div>
    <div class="marquee">
      <div class="pista">
        {[...lista, ...lista].map((m, i) => <a href={m.url} class="placa" aria-hidden={i >= lista.length ? 'true' : undefined} tabindex={i >= lista.length ? -1 : undefined}><img src={logoMarca(m.slug)!} alt={m.nombre} loading="lazy" width="160" height="44" /></a>)}
      </div>
    </div>
  </div>
</section>
<style>
  .franja { background: #fff; color: #0B1B3A; border-block: 1px solid var(--linea); }
  .franja .wrap { padding-block: var(--s-6); display: flex; align-items: center; gap: var(--s-6); }
  .rotulo { flex: none; max-width: 13rem; font-family: var(--f-display); font-weight: 600; font-size: 0.9375rem; line-height: 1.3; color: #001A4D; display: grid; gap: .375rem; }
  .rotulo .btn-enlace { font-size: var(--t-sm); justify-content: flex-start; }
  .marquee { flex: 1; min-width: 0; width: 100%; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .pista { display: flex; gap: var(--s-5); width: max-content; animation: desfile 60s linear infinite; }
  .pista:hover { animation-play-state: paused; }
  .placa { border: 0; padding: .5rem .75rem; height: 3.75rem; width: 10rem; flex: none; filter: grayscale(1); opacity: .8; transition: filter var(--dur-2), opacity var(--dur-2); }
  .placa:hover, .placa:focus-visible { filter: none; opacity: 1; }
  .placa img { max-height: 2.75rem; width: auto; max-width: 100%; object-fit: contain; }
  @keyframes desfile { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .pista { animation: none; flex-wrap: wrap; width: auto; } .marquee { mask-image: none; } .placa[aria-hidden] { display: none; } }
  @media (max-width: 760px) { .franja .wrap { flex-direction: column; align-items: flex-start; gap: var(--s-4); } .rotulo { max-width: none; } }
</style>
