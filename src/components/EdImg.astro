---
/**
 * Foto editable in situ (src, alt y encuadre). Conserva width/height/loading del código;
 * srcset/sizes opcionales (se omiten si el cliente reemplazó la foto).
 *   <EdImg id="home_nosotros_foto" src="/img/nosotros.webp" alt="…" width="900" height="900" loading="lazy" />
 */
import { ed } from '../lib/contenido';
interface Props { id: string; src: string; alt: string; [k: string]: any }
const { id, src, alt, style, srcset, sizes, ...rest } = Astro.props;
const d = ed(id);
const srcFinal = d.content || src;
const altFinal = typeof d.alt === 'string' && d.alt ? d.alt : alt;
const estilo = [style, d.pos ? `object-position:${d.pos}` : ''].filter(Boolean).join(';') || undefined;
---
{/* srcset solo con la foto del código: si el cliente la cambió, manda su foto */}
<img srcset={d.content ? undefined : srcset} sizes={d.content ? undefined : sizes} data-ed-img={id} data-ed-orig={src} data-ed-orig-alt={alt} src={srcFinal} alt={altFinal} style={estilo} {...rest} />
