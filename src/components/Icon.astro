---
import { iconos, type NombreIcono } from '../lib/icons';
interface Props { name: NombreIcono; label?: string; size?: number; class?: string; stroke?: number }
const { name, label, size = 24, class: cls = '', stroke = 1.8 } = Astro.props;
const rem = size / 16;
---
<svg viewBox="0 0 24 24" width={size} height={size} style={`width:${rem}rem;height:${rem}rem`} class={cls}
  fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round"
  role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false"
  set:html={iconos[name]} />
