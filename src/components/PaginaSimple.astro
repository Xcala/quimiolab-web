---
/**
 * Página institucional sencilla (política de datos, trabaja con nosotros, línea de transparencia, vinculación):
 * migas + eyebrow + H1 + bajada + contenido en .prosa y, opcional, tarjetas de contacto a la derecha.
 */
import Base from '../layouts/Base.astro';
import Miga from './Miga.astro';
import { migas } from '../lib/seo';
interface Props { titulo: string; descripcion: string; url: string; eyebrow: string; lead: string }
const { titulo, descripcion, url, eyebrow, lead } = Astro.props;
const ruta = [{ nombre: titulo, url }];
---
<Base title={titulo} description={descripcion} jsonld={[migas(ruta)]}>
  <section class="seccion tinte-2">
    <div class="wrap">
      <Miga items={ruta} />
      <span class="eyebrow">{eyebrow}</span>
      <h1>{titulo}</h1>
      <p class="lead">{lead}</p>
    </div>
  </section>
  <section class="seccion ps-cuerpo">
    <div class="wrap ps-grid">
      <div class="prosa"><slot /></div>
      <aside class="ps-lado"><slot name="lado" /></aside>
    </div>
  </section>
</Base>
<style>
  h1 { font-size: var(--t-3xl); margin: 0 0 var(--s-4); max-width: 22ch; }
  .lead { font-size: var(--t-lg); color: var(--ink-2); max-width: 60ch; margin: 0; }
  .ps-cuerpo { padding-top: var(--s-7); }
  .ps-grid { display: grid; grid-template-columns: minmax(0, 1fr) 20rem; gap: var(--s-8); align-items: start; }
  .ps-lado { display: grid; gap: var(--s-4); position: sticky; top: 7rem; }
  .ps-lado:empty { display: none; }
  @media (max-width: 900px) { .ps-grid { grid-template-columns: 1fr; } .ps-lado { position: static; } }
</style>
