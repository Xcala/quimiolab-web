---
/** Botón flotante de WhatsApp: canal donde el cliente cierra. Número pendiente (placeholder 573000000000). */
import Icon from './Icon.astro';
const numero = '573000000000';
const texto = encodeURIComponent('Hola Quimiolab, quisiera información sobre ');
---
<a class="wa" href={`https://wa.me/${numero}?text=${texto}`} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
  <Icon name="whatsapp" size={26} /><span>WhatsApp</span>
</a>
<style>
  .wa { position: fixed; right: max(1rem, env(safe-area-inset-right)); bottom: max(1rem, env(safe-area-inset-bottom)); z-index: 60; display: inline-flex; align-items: center; gap: .5rem; min-height: 3.25rem; padding: .75rem 1.125rem .75rem .875rem; border-radius: 999px; background: #25D366; color: #062B14; font-family: var(--f-body); font-weight: 700; font-size: var(--t-sm); box-shadow: 0 10px 28px rgba(0,26,77,.28); transition: transform var(--dur-2) var(--ease-out), box-shadow var(--dur-2); }
  .wa:hover { transform: translateY(-2px); box-shadow: 0 14px 32px rgba(0,26,77,.32); color: #062B14; }
  .wa:active { transform: scale(.97); }
  @media (max-width: 640px) { .wa span { display: none; } .wa { width: 3.5rem; height: 3.5rem; padding: 0; justify-content: center; } }
</style>
