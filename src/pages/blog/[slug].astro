---
import Base from '../../layouts/Base.astro';
import Miga from '../../components/Miga.astro';
import Imagen from '../../components/Imagen.astro';
import Icon from '../../components/Icon.astro';
import { posts, fecha } from '../../lib/data';
import { migas, articuloLd } from '../../lib/seo';
export async function getStaticPaths() { return posts.map((p, i) => ({ params: { slug: p.slug }, props: { post: p, anterior: posts[i + 1], siguiente: posts[i - 1] } })); }
const { post, anterior, siguiente } = Astro.props;
// WordPress repetía la portada como primera imagen del cuerpo (misma foto, otro tamaño): se quita esa primera <img> si coincide
const base = (u: string) => (u.split('/').pop() ?? '').replace(/-\d+x\d+/, '').replace(/-[0-9a-f]{8}\.\w+$/, '').replace(/\.\w+$/, '');
let contenido = post.contenido_html ?? '';
if (post.imagen?.src) {
  const primera = contenido.match(/^\s*(?:<p[^>]*>\s*)?(?:<a[^>]*>\s*)?<img[^>]*src="([^"]+)"[^>]*>\s*(?:<\/a>\s*)?(?:<\/p>\s*)?/i);
  if (primera && base(primera[1]) === base(post.imagen.src)) contenido = contenido.slice(primera[0].length);
}
const ruta = [{ nombre: 'Blog', url: '/blog/' }, { nombre: post.titulo, url: post.url }];
---
<Base heroImg={!!post.imagen} title={post.titulo} description={post.resumen} tipo="article" imagen={post.imagen?.src} jsonld={[migas(ruta), articuloLd(post)]}>
  <article class="articulo">
    <header class="wrap"><Miga items={ruta} /><span class="eyebrow">Blog científico</span><h1>{post.titulo}</h1><p class="meta muted">Publicado el <time datetime={post.fecha}>{fecha(post.fecha)}</time>{post.modificado.slice(0, 10) !== post.fecha.slice(0, 10) && <> · actualizado el <time datetime={post.modificado}>{fecha(post.modificado)}</time></>} · Equipo científico Quimiolab</p></header>
    {post.imagen && <div class="wrap portada"><Imagen img={post.imagen} alt={post.titulo} eager id="hero-img" /></div>}
    <div class="wrap"><div class="prosa" set:html={contenido} /></div>
    <footer class="wrap pie-articulo">
      <div class="cta"><div><h2>¿Te sirvió este contenido?</h2><p class="muted">Nuestro equipo científico puede ayudarte a implementar estas pruebas en tu laboratorio.</p></div><a class="btn btn-primario" href="/contactenos/">Hablar con un asesor <Icon name="flecha" size={16} /></a></div>
      <nav class="vecinos" aria-label="Otros artículos">
        {anterior && <a href={anterior.url} rel="prev"><span class="muted"><Icon name="flechaIzq" size={14} /> Anterior</span><b>{anterior.titulo}</b></a>}
        {siguiente && <a href={siguiente.url} rel="next" class="der"><span class="muted">Siguiente <Icon name="flecha" size={14} /></span><b>{siguiente.titulo}</b></a>}
      </nav>
    </footer>
  </article>
</Base>
<style>
  .articulo { padding-block: var(--s-6) var(--s-8); }
  header h1 { font-size: var(--t-3xl); max-width: 24ch; }
  .meta { margin-top: var(--s-4); font-size: var(--t-sm); }
  .portada { margin-block: var(--s-6); }
  .portada :global(img) { border-radius: var(--r-xl); max-height: 32rem; width: 100%; object-fit: cover; }
  .articulo .prosa { margin-top: var(--s-6); }
  .pie-articulo { margin-top: var(--s-8); display: grid; gap: var(--s-6); }
  .cta { display: flex; justify-content: space-between; align-items: center; gap: var(--s-5); flex-wrap: wrap; background: var(--canvas-2); border-radius: var(--r-xl); padding: var(--s-5) var(--s-6); }
  .cta h2 { font-size: var(--t-xl); }
  .vecinos { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); }
  .vecinos a { display: grid; gap: .25rem; padding: var(--s-4); border: 1px solid var(--linea); border-radius: var(--r-md); color: var(--ink); }
  .vecinos a:hover { border-color: var(--action); }
  .vecinos .muted { font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .08em; display: inline-flex; align-items: center; gap: .25rem; }
  .vecinos .der { text-align: right; } .vecinos .der .muted { justify-content: flex-end; }
  .vecinos b { font-family: var(--f-display); font-weight: 600; font-size: var(--t-sm); }
  @media (max-width: 640px) { .vecinos { grid-template-columns: 1fr; } }
</style>
