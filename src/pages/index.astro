    const play = () => { if (reduce) return; stop(); timer = window.setInterval(() => ir(i + 1), 5000); };
    const stop = () => { if (timer) clearInterval(timer); timer = undefined; };
    puntos.forEach((p) => p.addEventListener('change', () => { ir(Number(p.dataset.ir)); play(); }));
    escena.addEventListener('mouseenter', stop); escena.addEventListener('mouseleave', play);
    escena.addEventListener('focusin', stop); escena.addEventListener('focusout', play);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : play()));
    ir(0); play();
  }
</script>
