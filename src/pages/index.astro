---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Imagen from '../components/Imagen.astro';
import FranjaMarcas from '../components/FranjaMarcas.astro';
import FormularioContacto from '../components/FormularioContacto.astro';
import LogoSDBiosensor from '../components/LogoSDBiosensor.astro';
import LogoQLupa from '../components/LogoQLupa.astro';
import Ed from '../components/Ed.astro';
import EdImg from '../components/EdImg.astro';
import EdLink from '../components/EdLink.astro';
import { sitio, lineas, marcas, productos, equipos, posts, marcaPorSlug, logoMarca } from '../lib/data';

const hubs: Record<string, { titulo: string; texto: string; img: string; marcas: string[] }> = {
  'diagnostico': { titulo: 'Autoinmunidad, alergias e infecciosas', texto: 'Kits de diagnóstico avanzado con <strong>inmunoensayo, inmunofluorescencia y quimioluminiscencia</strong>.', img: '/img/diagnostico.jpg', marcas: ['aesku', 'vircell', 'binding-site'] },
  'diagnostico-molecular': { titulo: 'Genómica y resistencia antimicrobiana', texto: 'Identificación de <strong>mutaciones, perfiles genéticos y resistencia</strong> con precisión y rapidez.', img: '/img/molecular.jpg', marcas: ['elitechgroup', 'genolution', 'tianlong'] },
  'investigacion': { titulo: 'PCR, secuenciación y clonación', texto: 'Insumos especializados para investigación en <strong>genética, oncología y enfermedades infecciosas</strong>.', img: '/img/investigacion.jpg', marcas: ['mp-biomedicals', 'abm', 'ningbo-hls-medical'] },
  'point-of-care': { titulo: 'Resultados al lado del paciente', texto: 'Equipos automatizados para <strong>biomarcadores clave</strong> en urgencias, atención primaria y cuidados intensivos.', img: '/img/poc.jpg', marcas: ['sd-biosensor', 'thermo-fisher'] },
};
// Equipos protagonistas del home (packshot + marca + demo)
const destacados = ['helios-convencional', 'optilite', 'virclia-lotus', 'elite-ingenius', 'f2400-analyzer', 'b·r·a·h·m·s-kryptor-compact-plus'];
const equiposDestacados = destacados.map((s) => equipos.find((e) => e.slug === s)).filter(Boolean) as typeof equipos;
const [postDestacado, ...otrosPosts] = posts.slice(0, 4);
// Slider del hero: los 5 equipos principales (uno por aliado), packshots locales del Portafolio 2026
const heroEquipos = [
  { slug: 'helios-convencional', k: 'helios', img: '/img/equipos/helios.webp', w: 257, h: 348, tagline: 'Inmunofluorescencia automatizada · autoinmunidad', color: '#98B830' },
  { slug: 'optilite', k: 'optilite', img: '/img/equipos/optilite.webp', w: 748, h: 355, tagline: 'Proteínas especiales y cadenas ligeras libres', color: '#FCEA19' },
  { slug: 'virclia-lotus', k: 'virclia', img: '/img/equipos/virclia-lotus.webp', w: 630, h: 426, tagline: 'Quimioluminiscencia en monotest para infecciosas', color: '#009673' },
  { slug: 'elite-ingenius', k: 'elite', img: '/img/equipos/elite-ingenius.webp', w: 544, h: 463, tagline: 'PCR en tiempo real, de la muestra al resultado', color: '#74C043' },
  { slug: 'b·r·a·h·m·s-kryptor-compact-plus', k: 'kryptor', img: '/img/equipos/kryptor-compact-plus.webp', w: 505, h: 458, tagline: 'Inmunoensayo TRACE® para biomarcadores críticos', color: '#EF4135' },
];
const slides = heroEquipos.map((h) => { const e = equipos.find((x) => x.slug === h.slug); const m = e ? marcaPorSlug(e.marca) : undefined; return { ...h, nombre: e?.nombre ?? h.slug, url: e?.url ?? '/equipos/', marca: m?.nombre ?? '', logo: e ? logoMarca(e.marca) : '', color: m?.color ?? h.color }; });
const testimonios = [
  { k: 'vid', texto: 'Siempre hemos tenido un excelente acompañamiento de parte del asesor comercial así como de la parte científica.', quien: 'Santiago Estrada Mesa', cargo: 'Director · Fundación Organización VID', ini: 'SE' },
  { k: 'rvg', texto: 'Tienen un muy buen servicio y excelente oportunidad en respuesta, esperamos seguir contando con ustedes como proveedor.', quien: 'Alexander Acuña Fonseca', cargo: 'Auxiliar de Compras · RVG IPS Ltda.', ini: 'AA' },
  { k: 'compensar', texto: 'Buena disposición de la gerencia ante contingencias presentadas, excelente colaboración.', quien: 'Diana Carolina Hernández', cargo: 'Compensar EPS', ini: 'DH' },
];
const confianza = [
  { k: 'invima', ic: 'sello', b: 'Registro INVIMA', s: 'en todos los productos y equipos' },
  { k: 'iso', ic: 'certificado', b: 'ISO 9001', s: 'sistema de gestión certificado' },
  { k: 'respuesta', ic: 'reloj', b: 'Respuesta el mismo día hábil', s: 'asesor comercial y científico' },
  { k: 'soporte', ic: 'mapa', b: 'Soporte técnico en Bogotá', s: 'con cobertura en toda Colombia' },
  { k: 'capacitacion', ic: 'usuarios', b: 'Capacitación incluida', s: 'en cada implementación' },
];
---
<Base title="Quimiolab · Equipos y reactivos de diagnóstico con soporte científico en Colombia" description={sitio.descripcion} imagen="/og-quimiolab.jpg" gsap editable="home">
  <!-- 1. Hero: una promesa, el buscador como acción principal y el equipo protagonista -->
  <section class="hero" data-ed-sec="hero" data-ed-label="Portada">
    <div class="fondo"><EdImg id="home_hero_fondo" src="/img/hero.jpg" alt="Científica trabajando en un laboratorio clínico" width="1920" height="1080" loading="eager" decoding="async" fetchpriority="low" data-ed-fondo /></div>
    <div class="scrim"></div><span class="orbe o1"></span><span class="orbe o2 orbe-sd"></span><span class="patron patron-panel patron-oscuro"></span>
    <div class="wrap">
      <div class="endoso hero-endoso" aria-label="Una empresa de SD Biosensor"><small>Una empresa de</small><LogoSDBiosensor label="SD Biosensor" /></div>
      <div class="texto">
        <Ed id="home_hero_titulo" as="h1" data-gsap="words" data-gsap-hide>La ciencia detrás de <em>cada resultado</em></Ed>
        <Ed id="home_hero_lead" as="p" class="lead" data-gsap="rise" data-gsap-hide><strong>{marcas.length} marcas</strong> en diagnóstico clínico, biología molecular, investigación y point of care, con <strong>soporte técnico local</strong> en Colombia.</Ed>
        <form class="buscador" role="search" data-gsap="rise" data-gsap-hide action="/buscar/" method="get">
          <Icon name="buscar" size={20} />
          <input id="buscar-home" name="q" type="search" placeholder="Busca un equipo, reactivo o marca… ej. VirClia, Freelite" aria-label="Buscar en el catálogo" />
          <button class="btn btn-primario" type="submit">Buscar</button>
        </form>
        <div class="cta" data-gsap="rise" data-gsap-hide>
          <EdLink id="home_hero_btn_cotizar" class="btn btn-primario btn-lg" href="/contactenos/?tema=cotizacion"><Icon name="cotizar" size={18} /> <Ed id="home_hero_btn_cotizar">Solicitar cotización</Ed></EdLink>
          <EdLink id="home_hero_btn_equipos" class="btn btn-enlace enlace-claro" href="/equipos/"><Ed id="home_hero_btn_equipos">Ver los {equipos.length} equipos</Ed> <Icon name="flecha" size={16} /></EdLink>
        </div>
      </div>
      <div class="escena" data-gsap="pop" data-gsap-hide aria-roledescription="carrusel" aria-label="Equipos principales" style={`--n:${slides.length};${slides.map((sl, i) => `--c${i}:${sl.color}`).join(';')}`}>
        <LogoQLupa class="qlupa-deco q-hero" />
        <span class="brillo"></span>
        {slides.map((sl, i) => (
          <a class={`slide${i === 0 ? ' activa' : ''}`} href={sl.url} aria-label={`${sl.nombre}: ${sl.tagline}. Ver ficha`} data-slide={i} style={`--aliado:${sl.color};--i:${i}`} aria-hidden={i === 0 ? undefined : 'true'} tabindex={i === 0 ? undefined : -1}>
            <EdImg id={`home_slide_${sl.k}_foto`} class="equipo" src={sl.img} alt="" width={sl.w} height={sl.h} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
            <span class="placa placa-hero"><img src={sl.logo} alt={sl.marca} width="160" height="48" loading={i === 0 ? 'eager' : 'lazy'} /></span>
            <span class="glass ficha-mini"><b>{sl.nombre}</b><span>{sl.tagline}</span><i>Ver ficha <Icon name="flecha" size={14} /></i></span>
          </a>
        ))}
        <div class="puntos" role="tablist" aria-label="Elegir equipo">
          {slides.map((sl, i) => <span class="punto" style={`--i:${i}`}><input type="radio" name="hero-slide" id={`hero-slide-${i}`} value={i} data-ir={i} aria-label={sl.nombre} /><label for={`hero-slide-${i}`}><span></span></label></span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Franja de confianza: la pregunta "¿es seguro?" se responde antes que "¿qué venden?" -->
  <section class="confianza" aria-label="Respaldo y garantías" data-ed-sec="confianza" data-ed-label="Garantías">
    <div class="wrap">
      <ul class="bento garantias" data-gsap="fan">
        {confianza.map((c) => <li><span class="ic"><Icon name={c.ic as any} size={22} /></span><div><Ed id={`home_confianza_${c.k}_titulo`} as="b">{c.b}</Ed><Ed id={`home_confianza_${c.k}_texto`}>{c.s}</Ed></div></li>)}
        <li class="anios"><b class="tabular"><small>+</small><span data-gsap="count">30</span></b><div><Ed id="home_confianza_anios_texto">años representando marcas líderes en Colombia</Ed></div></li>
      </ul>
    </div>
  </section>

  <FranjaMarcas />

  <!-- 3. Equipos protagonistas -->
  <section class="seccion tinte-2" id="equipos" data-ed-sec="equipos" data-ed-label="Equipos">
    <div class="wrap">
      <div class="cabecera">
        <div><Ed id="home_equipos_eyebrow" class="eyebrow">Equipos</Ed><Ed id="home_equipos_titulo" as="h2" data-gsap="words">Los analizadores que instalamos y sostenemos en Colombia</Ed></div>
        <Ed id="home_equipos_lead" as="p" class="lead">Cada equipo llega con <strong>instalación, capacitación y soporte técnico local</strong>. Pide una demostración y lo vemos con tus muestras.</Ed>
      </div>
      <ul class="carrusel" aria-label="Equipos destacados">
        {equiposDestacados.map((e) => { const m = marcaPorSlug(e.marca); const logo = logoMarca(e.marca); return (
          <li class="equipo-card" style={m ? `--aliado:${m.color}` : undefined}>
            <a href={e.url} class="fig" aria-hidden="true" tabindex="-1"><span class="halo"></span><Imagen img={e.imagen} alt="" cuadrada /></a>
            <div class="cuerpo">
              {logo ? <span class="placa placa-card"><img src={logo} alt={m?.nombre ?? ''} width="120" height="36" loading="lazy" /></span> : <span class="chip chip-aliado">{m?.nombre}</span>}
              <h3><a href={e.url}>{e.nombre}</a></h3>
              <p class="muted">{e.resumen}</p>
              <div class="acciones"><a class="btn btn-secundario btn-sm" href={e.url}>Ficha técnica</a><a class="btn btn-enlace" href={`${e.url}#cotizar`}>Solicitar demo <Icon name="flecha" size={14} /></a></div>
            </div>
          </li>
        ); })}
      </ul>
      <div class="ver-todos"><a class="btn btn-secundario" href="/equipos/">Ver los {equipos.length} equipos <Icon name="flecha" size={16} /></a></div>
    </div>
  </section>

  <!-- 4. Soluciones por línea -->
  <section class="seccion" id="soluciones" data-ed-sec="soluciones" data-ed-label="Soluciones por línea">
    <div class="wrap">
      <div class="cabecera">
        <div><Ed id="home_soluciones_eyebrow" class="eyebrow">Soluciones por línea</Ed><Ed id="home_soluciones_titulo" as="h2" data-gsap="words">Encuentra tu solución según el área de tu laboratorio</Ed></div>
        <Ed id="home_soluciones_lead" as="p" class="lead">Cada línea reúne los <strong>equipos, reactivos y marcas</strong> que la respaldan, con su ficha y cotización en línea.</Ed>
      </div>
      <div class="hubs">
        {lineas.map((l) => { const h = hubs[l.slug]; return (
          <a class="hub" href={l.url} style={`--campana:var(--linea-${l.slug})`}>
            <EdImg id={`home_hub_${l.slug}_foto`} src={h.img} alt="" width="900" height="600" loading="lazy" /><span class="duo"></span>
            <span class="chip etiqueta">{l.nombre}</span>
            <Ed id={`home_hub_${l.slug}_titulo`} as="h3">{h.titulo}</Ed>
            <Ed id={`home_hub_${l.slug}_texto`} as="p"><Fragment set:html={h.texto} /></Ed>
            <div class="meta"><span>{h.marcas.map((s) => marcaPorSlug(s)?.nombre).filter(Boolean).join(' · ')}</span><Icon name="flecha" size={16} /></div>
          </a>
        ); })}
      </div>
      <p class="productos-nota">¿Buscas un reactivo puntual? <a href="/productos/">Explora las {productos.length} referencias del catálogo</a> por marca, línea o nombre.</p>
    </div>
  </section>

  <!-- 5. Nosotros + prueba social -->
  <section class="seccion seccion-navy" id="nosotros" data-ed-sec="nosotros" data-ed-label="Nosotros y testimonios">
    <span class="patron patron-red" style="--patron-op:.08;--patron-size:28rem"></span>
    <div class="wrap nosotros">
      <div class="foto"><EdImg id="home_nosotros_foto" src="/img/nosotros.jpg" alt="Equipo Quimiolab reunido en círculo" width="900" height="900" loading="lazy" data-parallax /><div class="sello" data-gsap="pop"><Icon name="certificado" size={40} /><div><Ed id="home_nosotros_sello_titulo" as="b">Sistema de gestión certificado</Ed><Ed id="home_nosotros_sello_texto">ICONTEC · ISO 9001</Ed></div></div></div>
      <div>
        <Ed id="home_nosotros_eyebrow" class="eyebrow">Nosotros</Ed>
        <Ed id="home_nosotros_titulo" as="h2" data-gsap="words">Un equipo humano confiable, desde Bogotá para toda Colombia</Ed>
        <Ed id="home_nosotros_lead" as="p" class="lead">Somos una organización colombiana que suministra <strong>soluciones integrales, innovadoras y diferenciadas</strong> para el diagnóstico in vitro. Trabajar con el corazón para <strong>mejorar la salud de los colombianos</strong> está en nuestro ADN.</Ed>
        <div class="numeros">
          <div class="num"><b class="tabular"><small>+</small><span data-gsap="count">30</span></b><Ed id="home_num_anios">años asesorando laboratorios</Ed></div>
          <div class="num"><b class="tabular" data-gsap="count">{marcas.length}</b><Ed id="home_num_marcas">marcas representadas de forma directa</Ed></div>
          <div class="num"><b class="tabular" data-gsap="count">{equipos.length}</b><Ed id="home_num_equipos">plataformas con soporte técnico local</Ed></div>
          <div class="num"><b class="tabular" data-gsap="count">{productos.length}</b><Ed id="home_num_productos">referencias en catálogo</Ed></div>
        </div>
        <EdLink id="home_nosotros_btn" class="btn btn-fantasma" href="/nosotros/"><Ed id="home_nosotros_btn">Conoce a Quimiolab</Ed> <Icon name="flecha" size={16} /></EdLink>
      </div>
    </div>
    <div class="wrap">
      <div class="citas">
        {testimonios.map((t) => <blockquote class="cita glass-oscuro"><Ed id={`home_testimonio_${t.k}_texto`} as="p">{t.texto}</Ed><footer><i>{t.ini}</i><div><Ed id={`home_testimonio_${t.k}_quien`} as="b">{t.quien}</Ed><Ed id={`home_testimonio_${t.k}_cargo`}>{t.cargo}</Ed></div></footer></blockquote>)}
      </div>
    </div>
  </section>

  <!-- 6. Micro-compromisos: pasos pequeños antes del formulario -->
  <section class="seccion nube con-patron" id="siguiente-paso" data-ed-sec="siguiente-paso" data-ed-label="Siguiente paso">
    <span class="patron patron-adn" style="--patron-color:#fff;--patron-op:.5;--patron-size:32rem"></span>
    <div class="wrap">
      <div class="cabecera"><div><Ed id="home_pasos_eyebrow" class="eyebrow">Siguiente paso</Ed><Ed id="home_pasos_titulo" as="h2" data-gsap="words">Empieza por lo que necesites hoy</Ed></div></div>
      <div class="bento pasos">
        <EdLink id="home_paso_catalogo" class="paso" href="/contactenos/?tema=catalogo"><span class="ic" style="--acento:var(--teal)"><Icon name="descargar" size={24} /></span><Ed id="home_paso_catalogo_titulo" as="h3">Catálogo 2026 en PDF</Ed><Ed id="home_paso_catalogo_texto" as="p">Todas las marcas, equipos y líneas en un solo documento. <strong>Te lo enviamos al correo.</strong></Ed><span class="link"><Ed id="home_paso_catalogo">Recibir catálogo</Ed> <Icon name="flecha" size={16} /></span></EdLink>
        <EdLink id="home_paso_demo" class="paso" href="/contactenos/?tema=demo"><span class="ic" style="--acento:var(--camp-naranja)"><Icon name="calendario" size={24} /></span><Ed id="home_paso_demo_titulo" as="h3">Demo de 20 minutos</Ed><Ed id="home_paso_demo_texto" as="p">Vemos el equipo con tus muestras y resolvemos <strong>las preguntas técnicas</strong> de tu equipo.</Ed><span class="link"><Ed id="home_paso_demo">Agendar demo</Ed> <Icon name="flecha" size={16} /></span></EdLink>
        <EdLink id="home_paso_disponibilidad" class="paso" href="/contactenos/?tema=disponibilidad"><span class="ic" style="--acento:var(--verde)"><Icon name="producto" size={24} /></span><Ed id="home_paso_disponibilidad_titulo" as="h3">Disponibilidad de una referencia</Ed><Ed id="home_paso_disponibilidad_texto" as="p">Dinos qué reactivo o consumible buscas y te confirmamos <strong>existencias y tiempo de entrega</strong>.</Ed><span class="link"><Ed id="home_paso_disponibilidad">Consultar disponibilidad</Ed> <Icon name="flecha" size={16} /></span></EdLink>
      </div>
    </div>
  </section>

  <!-- 7. Blog: autoridad científica -->
  <section class="seccion" id="contenidos" data-ed-sec="contenidos" data-ed-label="Blog">
    <div class="wrap">
      <div class="cabecera"><div><Ed id="home_blog_eyebrow" class="eyebrow">Blog científico</Ed><Ed id="home_blog_titulo" as="h2" data-gsap="words">Lo último en investigación y diagnóstico clínico</Ed></div><a class="btn btn-enlace" href="/blog/">Ver todo el blog <Icon name="flecha" size={16} /></a></div>
      <div class="blog">
        {postDestacado && <a class="destacado tarjeta" href={postDestacado.url}><div class="img duotono" style="--campana:var(--camp-teal)"><Imagen img={postDestacado.imagen} alt="" /></div><div class="cuerpo"><span class="chip">Artículo destacado</span><h3>{postDestacado.titulo}</h3><p class="muted">{postDestacado.resumen}</p><span class="link">Leer artículo <Icon name="flecha" size={16} /></span></div></a>}
        <div class="posts">
          {otrosPosts.map((p) => <a class="post" href={p.url}><div><h3>{p.titulo}</h3><p class="muted">{p.resumen}</p></div><span class="fl"><Icon name="flecha" size={16} /></span></a>)}
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Contacto -->
  <section class="seccion contacto" id="contacto" data-ed-sec="contacto" data-ed-label="Contacto">
    <div class="fondo"><EdImg id="home_contacto_fondo" src="/img/dna.jpg" alt="" width="1920" height="1080" loading="lazy" decoding="async" data-ed-fondo /></div><div class="scrim"></div><span class="orbe o1"></span><span class="orbe o2 orbe-sd"></span>
    <div class="wrap">
      <div>
        <Ed id="home_contacto_eyebrow" class="eyebrow">Contáctenos</Ed>
        <Ed id="home_contacto_titulo" as="h2" data-gsap="words">Hablemos de lo que necesita tu laboratorio</Ed>
        <Ed id="home_contacto_lead" as="p" class="lead">Un asesor comercial y científico te responde <strong>en el mismo día hábil</strong>. Cotizaciones, <strong>demostraciones de equipos</strong>, soporte técnico y capacitación.</Ed>
        <ul class="canales">
          <li><a href={`tel:${sitio.pbx_tel}`}><Icon name="telefono" size={18} /> PBX {sitio.pbx}</a></li>
          <li><EdLink id="home_contacto_whatsapp" href="https://wa.me/573000000000" rel="noopener"><Icon name="whatsapp" size={18} /> <Ed id="home_contacto_whatsapp">WhatsApp comercial</Ed></EdLink></li>
          <li><a href={`mailto:${sitio.correo}`}><Icon name="correo" size={18} /> {sitio.correo}</a></li>
          <li><span><Icon name="ubicacion" size={18} /> {sitio.direccion}</span></li>
        </ul>
      </div>
      <FormularioContacto />
    </div>
  </section>
</Base>

<style>
  /* ---- Hero ---- */
  .hero { position: relative; overflow: hidden; background: var(--grad-navy); color: #fff; isolation: isolate; }
  .hero .fondo { position: absolute; inset: 0; opacity: .5; filter: blur(6px); transform: scale(1.03); }
  .hero .fondo :global(img), .contacto .fondo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .hero .scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,26,77,.95) 0%, rgba(0,36,104,.82) 45%, rgba(0,48,135,.35) 100%), linear-gradient(0deg, rgba(0,26,77,.9) 0%, rgba(0,26,77,0) 40%); }
  .hero .orbe { z-index: 0; }
  .hero .o1 { width: 42rem; height: 42rem; right: -12rem; top: -14rem; background: radial-gradient(circle, rgba(0,151,214,.55) 0%, rgba(0,151,214,0) 68%); }
  .hero .o2 { width: 30rem; height: 30rem; left: 30%; bottom: -16rem; }
  .hero .patron { z-index: 0; --patron-op: .1; }
  .hero-endoso { position: absolute; right: var(--gutter); top: 1.75rem; z-index: 2; }
  @media (max-width: 900px) { .hero-endoso { position: static; margin-bottom: var(--s-4); } }
  .hero .wrap { position: relative; padding-block: clamp(4rem, 9vw, 7rem) clamp(3rem, 6vw, 5rem); display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: var(--s-7); align-items: center; }
  .hero h1 { color: #fff; font-size: clamp(2.25rem, 1.5rem + 2.9vw, 3.75rem); max-width: 20ch; margin-block: 0 var(--s-4); }
  .hero h1 em { font-style: normal; color: var(--brillante); }
  .hero .eyebrow { color: var(--brillante); }
  .hero .lead { font-size: clamp(1.0625rem, 1.4vw, 1.25rem); color: var(--azul-200); max-width: 42ch; margin-bottom: var(--s-6); }
  .hero .lead strong { color: #fff; }
