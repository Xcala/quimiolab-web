---
/** Páginas fijas que vienen del CMS con su URL exacta (política de denuncias y los 3 registros sanitarios INVIMA). */
import Base from '../layouts/Base.astro';
import Miga from '../components/Miga.astro';
import { paginas } from '../lib/data';
import { migas } from '../lib/seo';
export async function getStaticPaths() { return paginas.filter((p) => !['nosotros', 'contactenos'].includes(p.slug)).map((p) => ({ params: { slug: p.slug }, props: { pg: p } })); }
const { pg } = Astro.props;
const ruta = [{ nombre: pg.titulo, url: pg.url }];
const esRegistro = pg.slug.startsWith('registro-sanitario');
const DESCRIPCIONES: Record<string, string> = {
  molbio: 'Molbio Diagnostics: PCR en tiempo real portátil en el punto de atención para enfermedades infecciosas. Distribuido en Colombia por Quimiolab.',
  'politica-de-denuncias-y-no-retaliacion': 'Política de denuncias y no retaliación de Quimiolab S.A.S.: cómo reportar de forma confidencial y cómo protegemos a quien reporta.',
};
const TITULOS: Record<string, string> = { molbio: 'Molbio Diagnostics: PCR en tiempo real en el punto de atención' };
---
<Base title={TITULOS[pg.slug] ?? pg.titulo} description={esRegistro ? `${pg.titulo}. Documento de registro sanitario INVIMA publicado por Quimiolab.` : DESCRIPCIONES[pg.slug] ?? `${pg.titulo} de Quimiolab S.A.S.`} noindex={esRegistro} jsonld={[migas(ruta)]}>
  <section class="seccion"><div class="wrap"><Miga items={ruta} /><h1>{pg.titulo}</h1><div class="prosa" set:html={pg.contenido_html} /></div></section>
</Base>
<style> h1 { font-size: var(--t-3xl); margin-bottom: var(--s-6); max-width: 30ch; } </style>
