---
import Base from '../../../layouts/Base.astro';
import Listado from '../../../components/Listado.astro';
import { lineas, equiposDeLinea } from '../../../lib/data';
import { migas } from '../../../lib/seo';
export async function getStaticPaths() { return lineas.map((l) => ({ params: { linea: l.slug }, props: { linea: l } })); }
const { linea } = Astro.props;
const items = equiposDeLinea(linea.slug);
const ruta = [{ nombre: 'Soluciones', url: '/soluciones/' }, { nombre: linea.nombre, url: linea.url }, { nombre: 'Equipos', url: `${linea.url}equipos/` }];
---
<Base title={`Equipos de ${linea.nombre.toLowerCase()}`} description={`${items.length} equipos de ${linea.nombre.toLowerCase()} distribuidos en Colombia por Quimiolab.`} jsonld={[migas(ruta)]}>
  <Listado tipo="equipos" titulo={`Equipos · ${linea.nombre}`} eyebrow={`${items.length} referencias`} lead={linea.descripcion} items={items} pagina={1} total={1} base={`${linea.url}equipos/`} migas={ruta} filtroLinea={true} />
</Base>
